# OpenDev Elite — optional settings; defaults work without this file.
OPENDEV_PORT=8780
# Must match the exact address in the browser. Remote deployments require HTTPS.
OPENDEV_PUBLIC_ORIGIN=http://127.0.0.1:8780
OPENDEV_IMAGE=opendev-elite:0.8.0
OPENDEV_GATEWAY_IMAGE=opendev-elite-gateway:0.8.0
# Optional; anonymous GitHub discovery is rate limited.
GITHUB_TOKEN=
# Only used by the API after explicit Credits configuration and write enablement.
NEXT_CREDITS_PAT=
# For reproducible production builds, substitute reviewed image digests.
PYTHON_IMAGE=python:3.13-slim-bookworm
NGINX_IMAGE=nginx:stable-alpine
